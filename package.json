{
  "name": "twitch-chat-overlay-for-obs",
  "private": true,
  "version": "0.3.2",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint ./src",
    "format": "prettier --write ./",
    "fix": "bun run format && bun run lint",
    "preview": "vite preview",
    "deploy": "bun run build && gh-pages -d dist",
    "check": "bun run lint && prettier --check ./src",
    "audit": "bun audit",
    "audit:fix": "bun audit --fix",
    "audit:prod": "echo 'Note: Remaining vulnerabilities are development-only and do not affect production builds'"
  },
  "dependencies": {
    "@chakra-ui/react": "^2.10.9",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "eslint-config-prettier": "^10.1.5",
    "framer-motion": "^12.19.2",
    "gh-pages": "^6.3.0",
    "prettier": "^3.6.2",
    "react": "^18.3.1",
    "react-colorful": "^5.6.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.30.0",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.6.0",
    "eslint": "^9.30.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "globals": "^16.2.0",
    "terser": "^5.43.1",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.35.0",
    "vite": "^5.4.0"
  }
}
